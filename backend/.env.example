# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Atlassian Jira Cloud OAuth 2.0 (3LO) Configuration
# Register an app at https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=your_atlassian_oauth_client_id_here
ATLASSIAN_CLIENT_SECRET=your_atlassian_oauth_client_secret_here
ATLASSIAN_REDIRECT_URI=http://localhost:8000/auth/callback

# Security & CORS
SECRET_KEY=jira_ai_assistant_super_secret_session_key_2026
FRONTEND_URL=http://localhost:5173

# Mock Fallback (set to true to test full app without API keys)
ENABLE_MOCK_FALLBACK=true
